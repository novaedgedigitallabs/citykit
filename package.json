{
  "name": "@novaedgedigitallabs/citykit",
  "version": "1.3.0",
  "description": "World cities search, distance, geo utilities & India-specific tools — 49,992 cities, enriched with timezone, currency, calling code, continent & more",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./lite": {
      "types": "./dist/lite.d.ts",
      "import": "./dist/lite.mjs",
      "require": "./dist/lite.js"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "convert": "node scripts/convert.mjs",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cities",
    "world",
    "geo",
    "distance",
    "search",
    "coordinates",
    "countries",
    "geocoding",
    "haversine",
    "autocomplete",
    "timezone",
    "currency",
    "india",
    "bounding-box"
  ],
  "author": "NovaEdge Digital Labs",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/novaedgedigitallabs/citykit"
  },
  "homepage": "https://github.com/novaedgedigitallabs/citykit#readme",
  "bugs": {
    "url": "https://github.com/novaedgedigitallabs/citykit/issues"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "xlsx": "^0.18.5",
    "vitest": "^1.6.0"
  }
}
